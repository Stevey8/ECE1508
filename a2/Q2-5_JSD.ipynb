import numpy as np
import matplotlib.pyplot as plt

theta = np.linspace(0.01, 0.99, 1000)

# KL divergence P||Q
kl = theta * np.log(theta / 0.3) + (1 - theta) * np.log((1 - theta) / 0.7)

# JSD
M1 = (theta + 0.3) / 2
M2 = (1 - theta + 0.7) / 2
jsd = 0.5 * (theta * np.log(theta / M1) + (1 - theta) * np.log((1 - theta) / M2)) + \
      0.5 * (0.3 * np.log(0.3 / M1) + 0.7 * np.log(0.7 / M2))

plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
plt.plot(theta, kl)
plt.xlabel(r'$\theta$')
plt.title(r'$D_{KL}(P\|Q)$')
plt.axvline(x=0.3, color='r', linestyle='--', label=r'$\theta^* = 0.3$')
plt.legend()
plt.grid(True)

plt.subplot(1, 2, 2)
plt.plot(theta, jsd, color='green')
plt.xlabel(r'$\theta$')
plt.title(r'$D_{JSD}(P\|Q)$')
plt.axvline(x=0.3, color='r', linestyle='--', label=r'$\theta^* = 0.3$')
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()